DATABASE_URL=postgres://xui_app:change-me@127.0.0.1:5432/xui_commerce?sslmode=disable
BACKEND_LISTEN_ADDR=127.0.0.1:8088
BACKEND_WORKER_INTERVAL=5s
BACKEND_CLIENTS_JSON=[{"deployment_id":"retail-finland","token":"replace-with-32-or-more-random-characters"},{"deployment_id":"retail-germany","token":"replace-with-another-32-or-more-random-characters"},{"deployment_id":"reseller-turk1","token":"replace-with-a-third-32-or-more-random-characters"}]
XUI_PANEL_TOKENS_JSON={"panel-retail-finland":"replace-with-panel-api-token","panel-retail-germany":"replace-with-panel-api-token","panel-reseller-turk1":"replace-with-panel-api-token"}
# Optional for encrypted admin-managed panel token updates. Generate with: openssl rand -base64 32
BACKEND_PANEL_SECRETS_KEY=
TELEGRAM_BOT_TOKENS_JSON={"retail-finland":"replace-with-retail-finland-bot-token","retail-germany":"replace-with-retail-germany-bot-token","reseller-turk1":"replace-with-reseller-bot-token"}
